<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/standbyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/standbyClockPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <cn.modificator.launcher.widgets.OutlinedTextView
                android:id="@+id/standbyMode"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#000000"
                android:textSize="13sp"
                tools:text="待机页预览" />

            <cn.modificator.launcher.widgets.OutlinedTextView
                android:id="@+id/standbyTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#000000"
                android:textSize="64sp"
                tools:text="12:35" />

            <cn.modificator.launcher.widgets.OutlinedTextView
                android:id="@+id/standbyDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#000000"
                android:textSize="17sp"
                tools:text="5月11日 星期一" />

            <cn.modificator.launcher.widgets.OutlinedTextView
                android:id="@+id/standbyLunar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#000000"
                android:textSize="13sp"
                tools:text="上午" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <cn.modificator.launcher.widgets.BatteryView
                    android:id="@+id/standbyBatteryIcon"
                    android:layout_width="23dp"
                    android:layout_height="39dp" />

                <TextView
                    android:id="@+id/standbyBatteryLevel"
                    android:layout_width="88dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="16dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    tools:text="83%" />

                <TextView
                    android:id="@+id/standbyBatteryState"
                    android:layout_width="86dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    tools:text="充电中" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000" />

    <LinearLayout
        android:id="@+id/readingPage"
        android:layout_width="match_parent"
        android:layout_height="218dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/readingTitleBar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/readingStatus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="阅读进度"
                android:textColor="#000000"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/readingRefreshAction"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="48dp"
                android:text="刷新"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readingBooksList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
